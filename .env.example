# Telegram — obtenir le token via @BotFather
TELEGRAM_BOT_TOKEN=

# Ton user ID Telegram (via @userinfobot)
TELEGRAM_ALLOWED_USERS=

# Chemin absolu du projet à monter dans /workspace
# Exemples :
#   local  → WORKSPACE_PATH=/Users/mathys/Documents/mon-projet
#   NAS    → WORKSPACE_PATH=/volume1/projects/mon-projet
#   VPS    → WORKSPACE_PATH=/home/mathys/projects/mon-projet
WORKSPACE_PATH=./workspace
