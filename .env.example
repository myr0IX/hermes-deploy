# Rempli par `make setup` (assistant interactif). À la main : mettre les
# valeurs entre apostrophes, sinon Compose interprète les `$` qu'elles contiennent.

# --- Modèle : décommenter UNE seule clé ---
# Le modèle par défaut est anthropic/claude-opus-4.6 : avec une clé OpenAI ou
# OpenRouter seule, changer `model` dans data/config.yaml après le 1er lancement.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- Telegram ---
# `make setup` crée le bot par QR code et détecte ton user ID.
# À la main : token via @BotFather, user ID via @userinfobot.
TELEGRAM_BOT_TOKEN=

# Ton user ID Telegram.
# Attention : c'est l'ID de TON compte humain, pas le préfixe numérique du
# token du bot (123456789:ABC... → 123456789 n'est PAS la bonne valeur).
# Plusieurs utilisateurs : séparés par des virgules, sans espace.
TELEGRAM_ALLOWED_USERS=

# --- Dashboard (obligatoire) ---
# Sans ces identifiants Hermes refuse de démarrer : le dashboard écoute sur
# 0.0.0.0 dans le conteneur, donc il exige une authentification.
# SECRET (openssl rand -hex 32) garde les sessions valides après redémarrage.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# --- Permissions ---
# UID/GID de l'utilisateur hôte propriétaire de data/ et workspace/, posés
# par `make setup` (sinon `id -u` et `id -g`). Sans ça le conteneur tourne en UID 10000 :
# workspace/ devient inaccessible en écriture et data/ n'est plus éditable.
HERMES_UID=1000
HERMES_GID=1000

# Chemin absolu du projet à monter dans /workspace
# Exemple : WORKSPACE_PATH=/home/user/projects/mon-projet
WORKSPACE_PATH=./workspace

# Override de la version d'image (défaut dans docker-compose.yml)
# HERMES_VERSION=v2026.9.7
